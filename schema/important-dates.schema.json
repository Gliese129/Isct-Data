{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "academicYear",
    "timezone",
    "source",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "academicYear": {
      "type": "integer"
    },
    "timezone": {
      "const": "Asia/Tokyo"
    },
    "source": {
      "type": "array"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "startDate",
          "endDate",
          "label",
          "category",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "object",
            "required": [
              "ja"
            ],
            "properties": {
              "ja": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "category": {
            "enum": [
              "campus-festival",
              "ceremony",
              "academic",
              "other"
            ]
          },
          "sourceIds": {
            "type": "array"
          },
          "labelEnglishSource": {
            "enum": [
              "official",
              "translation"
            ]
          }
        }
      }
    }
  }
}
